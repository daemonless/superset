#!/bin/sh
# Start superset; /init has already dropped to the run user.

echo "[INFO] Starting Superset..."

# gunicorn is pkg-installed (no venv entrypoint); run its module under the
# venv python so it can import superset from the venv site-packages.
exec /app/venv/bin/python -m gunicorn \
    'superset.app:create_app()' \
    --bind "0.0.0.0:8088" \
    --workers "${SUPERSET_WORKERS:-2}" \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
