ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
# "latest" resolves from PyPI at build time; pin with --build-arg SUPERSET_VERSION=x.y.z
ARG SUPERSET_VERSION=latest
ARG UPSTREAM_URL="https://pypi.org/pypi/apache-superset/json"
ARG UPSTREAM_JQ=".info.version"
# Compiled deps only; pure-python comes from upstream's lock further down.
# py312-paramiko is pure but pulls the native bcrypt/PyNaCl/cffi chain.
ARG PACKAGES="python3 py312-pip py312-sqlite3 py312-cryptography py312-greenlet py312-numpy py312-pandas py312-pyarrow py312-pillow py312-msgpack py312-nh3 py312-pydantic2 py312-pydantic-core py312-bottleneck py312-watchdog py312-paramiko py312-sqlalchemy14 py312-markupsafe py312-psycopg2 py312-pyyaml py312-jsonschema py312-rpds-py py312-apsw py312-msgspec py312-brotli py312-backports.zstd py312-zstandard"

LABEL org.opencontainers.image.title="Superset" \
      org.opencontainers.image.description="Modern data exploration and visualization platform on FreeBSD." \
      org.opencontainers.image.source="https://github.com/daemonless/superset" \
      org.opencontainers.image.url="https://superset.apache.org/" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Productivity" \
      io.daemonless.port="8088" \
      io.daemonless.healthcheck-url="http://localhost:8088/health" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.packages="${PACKAGES}"

RUN sed -i '' -e 's,/quarterly,/latest,' /etc/pkg/FreeBSD.conf && \
    pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# The venv sees the pkg site-packages; the freeze records what they provide.
RUN python3 -m venv --system-site-packages /app/venv && \
    /app/venv/bin/pip freeze --all > /app/constraints.txt

ENV PATH="/app/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"

# --no-deps: superset's pins (pandas<2.2, pyarrow<19, ...) conflict with
# the newer pkg versions and would trigger source builds.
RUN if [ "${SUPERSET_VERSION}" = "latest" ]; then \
        SUPERSET_VERSION=$(fetch -qo - "${UPSTREAM_URL}" | \
            python3 -c "import json,sys; print(json.load(sys.stdin)['info']['version'])"); \
    fi && \
    echo "Resolved apache-superset==${SUPERSET_VERSION}" && \
    pip install --no-cache-dir --no-deps \
        apache-superset==${SUPERSET_VERSION} apache-superset-core && \
    pip show apache-superset | awk '/^Version:/{print $2}' > /app/version

# Pure-python deps at upstream's exact tested versions (requirements/base.txt
# is their complete pip-compiled closure), minus what the packages provide.
COPY scripts/filter-lock.py /tmp/filter-lock.py
RUN fetch -qo /tmp/base-lock.txt \
        "https://raw.githubusercontent.com/apache/superset/$(cat /app/version)/requirements/base.txt" && \
    python3 /tmp/filter-lock.py && \
    pip install --no-cache-dir --no-deps -r /tmp/requirements-locked.txt && \
    rm /tmp/base-lock.txt /tmp/requirements-locked.txt /tmp/filter-lock.py

# Compat patches for running newer natives than upstream's lock:
# - numpy aliases removed in 2.0 (drop when upstream supports numpy 2)
# - pandas 2.2+ refuses sqlalchemy<2, breaking df.to_sql/CSV upload
#   (drop when superset lifts its sqlalchemy<2 pin)
RUN cd /app/venv/lib/python3.12/site-packages && \
    find superset -name "*.py" -exec \
        sed -i '' -e 's/np\.product/np.prod/g; s/np\.NaN/np.nan/g' {} + && \
    sed -i '' -e 's/"sqlalchemy": "2.0.0"/"sqlalchemy": "1.4.0"/' \
        /usr/local/lib/python3.12/site-packages/pandas/compat/_optional.py

# Build-time sanity: import, migrations, and the pandas/sqlalchemy bridge.
RUN SUPERSET_HOME=/tmp/spike SUPERSET_SECRET_KEY=build-check HOME=/tmp/spike \
        python -c "import superset; print('import OK')" && \
    SUPERSET_HOME=/tmp/spike SUPERSET_SECRET_KEY=build-check HOME=/tmp/spike \
        superset db upgrade && \
    python -c "import pandas, sqlalchemy; \
pandas.DataFrame({'x':[1]}).to_sql('t', sqlalchemy.create_engine('sqlite://')); \
print('to_sql OK')" && \
    rm -rf /tmp/spike

ENV SUPERSET_HOME=/config \
    SUPERSET_CONFIG_PATH=/app/superset_config.py \
    HOME=/config

COPY root/ /

RUN chown -R bsd:bsd /app && \
    chmod +x /etc/services.d/superset/run /etc/cont-init.d/10-superset /healthz

EXPOSE 8088
VOLUME /config
